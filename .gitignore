# Hanya kode aplikasi dan dokumentasinya yang masuk repository.
/*
!/.gitignore
!/README.md
!/pasang.sh
!/studio/
/studio/*
!/studio/requirements.txt
!/studio/README.md
!/studio/studio_rgbd/
!/studio/studio_rgbd/**
!/perangkat/
/perangkat/*
!/perangkat/desktop/
!/perangkat/desktop/**
/perangkat/desktop/studio.log
!/arsip/
/arsip/*
!/arsip/catatan_gpt/
/arsip/catatan_gpt/*
!/arsip/catatan_gpt/BRIEF_UNTUK_GPT.md
!/arsip/unet_baru/
!/arsip/unet_baru/**
!/arsip/artefak_unet/
!/arsip/artefak_unet/**
/arsip/artefak_unet/*.mp4
/arsip/artefak_unet/*.mp4.json
/studio/.venv/
/studio/__pycache__/

# Data yang dibuat aplikasi selalu lokal dan dapat sangat besar.
/.venv/
/dataset/
/keluaran/
/model/
/runs*/
*.bag
*.ply
*.pt
__pycache__/
*.pyc

# Artefak eksperimen U-Net yang dipilih secara eksplisit untuk reproduksi.
# Dataset, checkpoint sementara, dan artefak model lain tetap diabaikan.
!/arsip/artefak_unet/*.pt

# Rahasia (token, kredensial) tidak pernah masuk Git, di folder mana pun.
# Aturan ini sengaja paling bawah agar mengalahkan pengecualian di atasnya.
**/.env
**/.env.*
!**/.env.example
*.token
.huggingface/
!/.githooks/
!/.githooks/**
