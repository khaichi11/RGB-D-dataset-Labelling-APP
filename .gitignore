# Hanya kode aplikasi dan dokumentasinya yang masuk repository.
/*
!/.gitignore
!/README.md
!/BRIEF_UNTUK_GPT.md
!/kode/
/kode/*
!/kode/requirements.txt
!/kode/README.md
!/kode/studio_rgbd/
!/kode/studio_rgbd/**
!/desktop/
!/desktop/**
!/unet-new/
!/unet-new/**
!/artefak_unet/
!/artefak_unet/**
/artefak_unet/*.mp4
/artefak_unet/*.mp4.json
/desktop/studio.log
/kode/.venv/
/kode/__pycache__/

# Data yang dibuat aplikasi selalu lokal dan dapat sangat besar.
/.venv/
/dataset/
/keluaran/
/model/
/runs*/
*.bag
*.ply
*.pt
__pycache__/
*.pyc

# Artefak eksperimen U-Net yang dipilih secara eksplisit untuk reproduksi.
# Dataset, checkpoint sementara, dan artefak model lain tetap diabaikan.
!/artefak_unet/*.pt
