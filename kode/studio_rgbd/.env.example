# Salin berkas ini menjadi paket_ubuntu_zenexo/.env (akar proyek, diabaikan Git)
# lalu isi nilainya. JANGAN menaruh token di berkas yang di-commit.
#
# Token tulis: https://huggingface.co/settings/tokens  (jenis "Write")
HF_TOKEN=
# Repo dataset tujuan tombol "Push dataset ke HF" (tab 7. Split Dataset)
HF_DATASET_REPO=khaichi11/Stairs-Skripsi
# Repo model tujuan registri model (skrip/utama/unggah_model_hf.py)
HF_MODEL_REPO=khaichi11/Skripsi
# Repo BARU dibuat privat bila true; visibilitas repo yang sudah ada tidak diubah
HF_PRIVATE=true
